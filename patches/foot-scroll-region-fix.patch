+        .grid = &term.normal,
+        .selection = {
+            .coords = {
+                .start = {-1, -1},
+                .end = {-1, -1},
+            },
+            .kind = SELECTION_NONE,
+            .auto_scroll = {
+                .fd = -1,
+            },
+        },
+    };
+
+#define populate_rows() do {                                            \
+        for (int i = 0; i < scrollback_rows; i++) {                     \
+            if (term.normal.rows[i] == NULL) {                          \
+                struct row *r = xcalloc(1, sizeof(*term.normal.rows[i])); \
+                r->cells = xcalloc(cols, sizeof(r->cells[0]));          \
+                term.normal.rows[i] = r;                                \
+            }                                                           \
+        }                                                               \
+    } while (0)
+
+    /* Screen rows carry 'A'..'E'; rows below the screen stay empty so we
+     * can detect anything leaking out of a confined scroll region. */
+#define tag_screen_rows() do {                                          \
+        for (int i = 0; i < term_rows; i++)                             \
+            term.grid->rows[i]->cells[0].wc = U'0' + i;                 \
+    } while (0)
+
+#define assert_screen_untagged_outside(...) do {                        \
+        for (int i = term_rows; i < scrollback_rows; i++)               \
+            xassert(term.grid->rows[i]->cells[0].wc == 0);              \
+    } while (0)
+
+    /*
+     * Test case 1 - confined scroll up: content must rotate inside the
+     * region, the top line of the region must be discarded, and nothing
+     * may be written outside the screen (in particular not into the
+     * scrollback).
+     */
+    populate_rows();
+    tag_screen_rows();
+    term.normal.offset = 0;
+    term.normal.view = 0;
+    term.grid->cur_row = term.grid->rows[0];
+    term.scroll_region = (struct scroll_region){.start = 1, .end = 5};
+
+    term_scroll_partial(&term, term.scroll_region, 1);
+
+    xassert(term.normal.offset == 0);
+    xassert(term.grid->rows[0]->cells[0].wc == U'0');      /* non-scrolling */
+    xassert(term.grid->rows[1]->cells[0].wc == U'2');      /* rotated up */
+    xassert(term.grid->rows[2]->cells[0].wc == U'3');
+    xassert(term.grid->rows[3]->cells[0].wc == U'4');
+    xassert(term.grid->rows[4]->cells[0].wc == 0);         /* scrolled in, erased */
+    assert_screen_untagged_outside();
+
+    /*
+     * Test case 2 - confined scroll down: same, mirrored; must not
+     * consume scrollback lines either.
+     */
+    populate_rows();
+    tag_screen_rows();
+    term.normal.offset = 0;
+    term.normal.view = 0;
+    term.grid->cur_row = term.grid->rows[0];
+    term.scroll_region = (struct scroll_region){.start = 1, .end = 5};
+
+    term_scroll_reverse_partial(&term, term.scroll_region, 1);
+
+    xassert(term.normal.offset == 0);
+    xassert(term.grid->rows[0]->cells[0].wc == U'0');
+    xassert(term.grid->rows[1]->cells[0].wc == 0);         /* scrolled in, erased */
+    xassert(term.grid->rows[2]->cells[0].wc == U'1');      /* rotated down */
+    xassert(term.grid->rows[3]->cells[0].wc == U'2');
+    xassert(term.grid->rows[4]->cells[0].wc == U'3');
+    assert_screen_untagged_outside();
+
+    /*
+     * Test case 3 - region including the top of the screen: must keep
+     * pushing the scrolled-out line into scrollback.
+     */
+    populate_rows();
+    tag_screen_rows();
+    term.normal.offset = 0;
+    term.normal.view = 0;
+    term.grid->cur_row = term.grid->rows[0];
+    term.scroll_region = (struct scroll_region){.start = 0, .end = 5};
+
+    term_scroll_partial(&term, term.scroll_region, 1);
+
+    xassert(term.normal.offset == 1);
+    /* Newest scrollback line is the old top screen line. */
+    xassert(term.grid->rows[0]->cells[0].wc == U'0');
+    xassert(term.grid->rows[term.normal.offset + 0]->cells[0].wc == U'1');
+    xassert(term.grid->rows[term.normal.offset + 1]->cells[0].wc == U'2');
+    xassert(term.grid->rows[term.normal.offset + 2]->cells[0].wc == U'3');
+    xassert(term.grid->rows[term.normal.offset + 3]->cells[0].wc == U'4');
+    xassert(term.grid->rows[term.normal.offset + 4]->cells[0].wc == 0);
+
+    /*
+     * Test case 4 - full-screen reverse scroll with an empty
+     * scrollback: the offset must not move (decrementing it would
+     * rotate unallocated rows from above the screen into the
+     * visible screen).
+     */
+    populate_rows();
+    tag_screen_rows();
+    term.normal.offset = 0;
+    term.normal.view = 0;
+    term.grid->cur_row = term.grid->rows[0];
+    term.scroll_region = (struct scroll_region){.start = 0, .end = 5};
+
+    /* Mirror the alternate screen / empty history: rows above the
+     * screen top (ring slots outside the screen) are unallocated. */
+    for (int i = term_rows; i < scrollback_rows; i++) {
+        grid_row_free(term.grid->rows[i]);
+        term.grid->rows[i] = NULL;
+    }
+
+    term_scroll_reverse_partial(&term, term.scroll_region, 1);
+
+    xassert(term.normal.offset == 0);
+    xassert(term.grid->rows[0]->cells[0].wc == 0);         /* scrolled in, erased */
+    xassert(term.grid->rows[1]->cells[0].wc == U'0');      /* rotated down */
+    xassert(term.grid->rows[2]->cells[0].wc == U'1');
+    xassert(term.grid->rows[3]->cells[0].wc == U'2');
+    xassert(term.grid->rows[4]->cells[0].wc == U'3');
+    for (int i = term_rows; i < scrollback_rows; i++)
+        xassert(term.grid->rows[i] == NULL);               /* still untouched */
+
+    /* Cleanup */
+    for (int i = 0; i < scrollback_rows; i++)
+        grid_row_free(term.normal.rows[i]);
+    free(term.normal.rows);
+    fdm_destroy(fdm);
+}
