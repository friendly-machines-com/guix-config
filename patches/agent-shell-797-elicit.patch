 agent-shell-elicitation.el             | 1436 ++++++++++++++++++++++++
 agent-shell-viewport.el                |    8 +
 agent-shell.el                         |   85 +-
 tests/agent-shell-elicitation-tests.el |  987 ++++++++++++++++
 tests/claude-ask-user-question.traffic |  144 +++
 6 files changed, 2657 insertions(+), 11 deletions(-)
 create mode 100644 agent-shell-elicitation.el
 create mode 100644 tests/agent-shell-elicitation-tests.el
 create mode 100644 tests/claude-ask-user-question.traffic

