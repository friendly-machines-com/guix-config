+		free(state);
+		sway_log(SWAY_ERROR, "Unable to allocate pending input-method state");
+		return;
+	}
+
+	wl_list_insert(relay->pending_im_events.prev, &state->event.link);
+	relay_process_pending_im_events(relay);
