+             (properties
+              (choices
+               (type . "array")
+               (items
+                (type . "_future")
+                (enum . ["one"])))))))
+         (field (seq-first (map-elt form :fields))))
+    (should (eq (map-elt field :kind) 'unsupported))
+    (should (equal (map-elt field :raw-type) "array"))
+    (should (equal (map-elt field :raw-item-type) "_future")))))
