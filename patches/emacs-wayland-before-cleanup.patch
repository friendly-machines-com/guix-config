diff -ru orig/emacs-30.2/src/pgtkfns.c emacs-30.2/src/pgtkfns.c
--- orig/emacs-30.2/src/pgtkfns.c	1970-01-01 01:00:01.000000000 +0100
+++ emacs-30.2/src/pgtkfns.c	2026-02-02 01:32:35.484221620 +0100
@@ -1311,6 +1311,18 @@
 
   FRAME_DISPLAY_INFO (f) = dpyinfo;
 
+  /* Update child process environment variables from frame parameters.
+     These are passed by emacsclient to set the correct WAYLAND_DISPLAY
+     and DISPLAY for child processes spawned from this frame.  */
+  tem = gui_display_get_arg (dpyinfo, parms, Qchild_env_wayland_display,
+			     NULL, NULL, RES_TYPE_STRING);
+  if (STRINGP (tem))
+    dpyinfo->child_env_wayland_display = tem;
+  tem = gui_display_get_arg (dpyinfo, parms, Qchild_env_display,
+			     NULL, NULL, RES_TYPE_STRING);
+  if (STRINGP (tem))
+    dpyinfo->child_env_display = tem;
+
   /* With FRAME_DISPLAY_INFO set up, this unwind-protect is safe.  */
   record_unwind_protect (do_unwind_create_frame, frame);
 
