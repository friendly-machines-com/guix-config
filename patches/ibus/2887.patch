@@ -2231,7 +2491,7 @@ input_method_keyboard_key (void                      *data,
                                                     0,
                                                     FALSE);
         if (!retval)
-            ibus_wayland_im_key (wlim, key_serial, time, key, state);
+            ibus_wayland_im_keycode (wlim, key_serial, time, key, state);
