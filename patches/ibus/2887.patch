         break;
     default:
         g_assert_not_reached ();
@@ -1505,6 +1764,7 @@ ibus_xkb_keymap_update_with_keymap (IBusXkbKeymap     *ibus_keymap,
         xkb_state_unref (ibus_keymap->state);
