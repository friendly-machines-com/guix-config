From 06e1978f41c4ebb2bb7c7d638d7916616b288ef4 Mon Sep 17 00:00:00 2001
From: fujiwarat <takao.fujiwara1@gmail.com>
Date: Tue, 11 Aug 2026 15:13:29 +0900
Subject: [PATCH 3/3] tools/main: Fix `ibus exit` in Plasma Wayland 6.7

ibus-ui-gtk3 now can be launched directly in Plasma Wayland without
KDE D-Bus methods and the desktop file so `ibus exit` also can
be executed without the desktop file.

Part-of: #2887
---
 tools/main.vala | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tools/main.vala b/tools/main.vala
index a7c6d95d7..c2f76326f 100644
--- a/tools/main.vala
+++ b/tools/main.vala
@@ -650,9 +650,12 @@ bool operate_daemon_in_kde_wayland(GLib.DBusConnection connection,
                             "restarted.\n");
                 } else {
                     stderr.printf("kwinrc is not updated for exit.\n");
-                    return true;
+                    return false;
                 }
             }
+        // KDE Plasma 6.7 no longer need kwinrc but run ibus-ui-gtk3 directly.
+        } else if (!is_updated && !start) {
+            return false;
         }
     } catch (GLib.KeyFileError e) {
         stderr.printf("%s\n", e.message);
